# Process and listeners
NODE_ENV=development
PORT=3002
# Exact TRP enables the separate public TLS listener. Any other value is Auth-only HTTP.
# PROTOCOL=TRP
TRP_PORT=3001

# PostgreSQL. Supply either DATABASE_URL or DATABASE_URL_FILE, never both.
DATABASE_URL=postgres://user:password@127.0.0.1:5432/defy_db
# DATABASE_URL_FILE=/run/secrets/database-url
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_QUERY_TIMEOUT_MS=5000

# Authentication. Secret placeholders must be replaced before startup.
JWT_KEY=
# JWT_KEY_FILE=/run/secrets/jwt-key
# OIDC_ISSUER=https://identity.example.invalid/realms/defy
# OIDC_AUDIENCE=defy-travel-rule
# OIDC_EMAIL_CLAIM=email
SERVICE_API_KEY=replace-with-32-byte-random-hex
# SERVICE_API_KEY_FILE=/run/secrets/service-api-key
# Exact TRP startup uses this only to seed an absent encrypted database row; persisted configuration wins after rotation/restart.

# Same-origin gateway normally needs no CORS middleware. Use comma-separated origins only for an approved non-browser client boundary.
CORS_ORIGINS=

# Recovery/welcome link origin. Compose local auth/UI is http://localhost:3000.
FRONTEND_URL=http://localhost:3000

# Email. disabled creates no transporter. Exact smtp requires every SMTP field and verifies the server at startup.
EMAIL_MODE=disabled
EMAIL_HOST=smtp.example.invalid
EMAIL_PORT=587
EMAIL_USER=no-reply@example.invalid
# EMAIL_PASS=
# EMAIL_PASS_FILE=/run/secrets/email-password

# Travel Rule Protocol 3.2.1. Required only for exact PROTOCOL=TRP.
TRP_PUBLIC_BASE_URL=https://trp.example.invalid:3001
TRP_VASP_NAME=Example VASP
TRP_VASP_LEI=00000000000000000000
TRP_SERVER_CERT_PATH=/run/secrets/trp/server-cert.pem
TRP_SERVER_KEY_PATH=/run/secrets/trp/server-key.pem
TRP_SERVER_CA_PATH=/run/secrets/trp/server-ca.pem
TRP_CLIENT_CERT_PATH=/run/secrets/trp/client-cert.pem
TRP_CLIENT_KEY_PATH=/run/secrets/trp/client-key.pem
TRP_CLIENT_CA_PATH=/run/secrets/trp/client-ca.pem
TRP_DATA_ENCRYPTION_KEY=
# TRP_DATA_ENCRYPTION_KEY_FILE=/run/secrets/trp/data-encryption-key
# TRP_DATA_ENCRYPTION_ACTIVE_KEY_ID=primary
# TRP_DATA_ENCRYPTION_LEGACY_KEY_ID=primary
# TRP_DATA_ENCRYPTION_RETIRED_KEYS={"2025-q4":"base64-encoded-32-byte-key"}
# TRP_DATA_ENCRYPTION_RETIRED_KEYS_FILE=/run/secrets/trp/data-encryption-retired-keys
TRP_RETENTION_DAYS=1825
TRP_TOKEN_TTL_SECONDS=86400
TRP_HTTP_TIMEOUT_MS=10000
TRP_EMAIL_FALLBACK_DELAY_MINUTES=30

# Proxy trust is not environment-configurable: internal app trusts exactly one Nginx hop; public TLS app trusts none.
